# Local DOSBox conf (absolute mount paths)
config/dosbox.local.conf

# Games live wherever you keep them, never inside the repository.

# Local staging output and saved launcher settings
stage/
dgb-local.json

# bin/ holds built artifacts only. A launcher directory deployed into it (as
# 'install' or a manual copy would create) is local scratch, never committed.
bin/*/
!bin/UTILS/

# OS / editor
.DS_Store
Thumbs.db
*~
*.swp
*.tmp
.reflex/
.vscode/

# Agent/assistant state stays out of the published tree entirely.
.claude/

# Python
__pycache__/
*.egg-info/
*.py[cod]
.venv/
venv/

# Stray dirs from shell test fixtures with odd names
(HEAD)/
(working)/

# Build scratch / staged media (regenerate with 'python dgb.py stage')
dist/
media/
*.o
*.obj
*.map
