*.egg-info/
*.py[cod]
.venv/
venv/

# Stray dirs from shell test fixtures with odd names
(HEAD)/
(working)/

# Build scratch / staged media (regenerate with 'python dgb.py stage')
dist/
media/
*.o
*.obj
*.map
